# 开发环境配置模板
# 复制此文件为 .env 并根据需要修改
# cp .env.example .env

# 数据库连接（docker compose up -d 启动 PostgreSQL）
DATABASE_URL=postgresql+asyncpg://postgres:<DB_PASSWORD>@localhost:5432/customer_service_ticket

# 认证开关：false 时跳过 Keycloak 校验，使用默认开发用户（仅用于本地开发）
AUTH_ENABLED=true

# Keycloak OIDC 认证
KEYCLOAK_ISSUER=http://10.8.6.32:18080/realms/company-dev
KEYCLOAK_JWKS_URL=http://10.8.6.32:18080/realms/company-dev/protocol/openid-connect/certs
KEYCLOAK_AUDIENCE=shouhou-gongdan-api

# Redis 连接（docker compose up -d 启动 Redis）
REDIS_URL=redis://localhost:6379/0

# 销售易 CRM 对接（可选，未配置 XIAOSHOUYI_BASE_URL 时跳过同步）
# XIAOSHOUYI_TOKEN_URL=https://login.xiaoshouyi.com/auc/oauth2/token
# XIAOSHOUYI_BASE_URL=
# XIAOSHOUYI_CLIENT_ID=
# XIAOSHOUYI_CLIENT_SECRET=
# XIAOSHOUYI_REDIRECT_URI=https://api-tencent.xiaoshouyi.com
# XIAOSHOUYI_USERNAME=
# XIAOSHOUYI_PASSWORD=
# 默认直连（不继承系统 HTTP_PROXY/HTTPS_PROXY）；确需代理时显式配置
# XIAOSHOUYI_PROXY_URL=http://proxy.example.com:8080
# XIAOSHOUYI_SYNC_TIMEOUT_SECONDS=20
